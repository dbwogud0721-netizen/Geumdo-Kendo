# ─────────────────────────────────────────────────────────────
# 금도검도관 환경변수 템플릿
# 이 파일을 복사해 .env.local 로 만들고 값 채우기 (로컬 테스트용).
# 배포는 Vercel → Settings → Environment Variables 에 동일하게 입력.
# ─────────────────────────────────────────────────────────────

# === 서버 전용 (firebase-admin) — 절대 NEXT_PUBLIC_ 붙이지 말 것 ===
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성(JSON)에서 추출
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key 는 JSON 값 통째로 (BEGIN/END 포함). 줄바꿈은 \n 그대로 둬도 됨.
FIREBASE_PRIVATE_KEY=

# 관리자 마스터 비밀번호 (서버 전용)
ADMIN_PASSWORD=

# === 클라이언트 (Cloudinary 갤러리 업로드) ===
# cloudinary.com → Dashboard 의 Cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Settings → Upload → Upload presets → Unsigned 프리셋 이름
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
